# Copy to .env and fill in. .env is gitignored: never commit real keys.

# BehaviorGPT (risk team). The Unbox SDK reads this exact name. Free key: https://portal.unboxai.com
UNBOXAI_API_KEY=

LLM_API_KEY=

# Optional: where the risk monitor keeps events (default shown)
# RISK_DB=risk/data/monitor.sqlite

# --- Agent team (bank/) ---
# OpenTelemetry spans for every agent action (OTLP over HTTP). 1 = on (default), 0 = off.
OTEL_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Pre-action risk gate: ask the risk monitor before high-impact actions. 0 = off (default).
GATE_ENABLED=0
# Where the gate calls (defaults to the OTLP endpoint above)
# RISK_API_URL=http://localhost:4318
