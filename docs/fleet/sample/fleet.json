   "snippet": "def is_risky(paused: int, sessions: int, budget: float = 0.05) -> bool:\n    # one-sided binomial test against the pause budget\n    p = binom_sf(paused - 1, sessions, budget)\n    return p < 0.01 and paused >= 3"
